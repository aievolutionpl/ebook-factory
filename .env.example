# Ebook Factory local environment
# Copy to .env only if your process manager loads env files. Do not commit .env.

# Optional HTTP Basic Auth for the local dashboard.
EBOOK_FACTORY_AUTH_USER=
EBOOK_FACTORY_AUTH_PASSWORD=

# Data directory used by the standard ASGI entrypoint (main.py).
EBOOK_FACTORY_DATA_DIR=.data

# Optional provider executable overrides. Credentials stay in your local tools.
EBOOK_FACTORY_CODEX_CLI=codex
EBOOK_FACTORY_CLAUDE_CODE=claude
